# Server Port
PORT=5000

# Environment: development | production
NODE_ENV=production

# MongoDB Connection String (optional - automatically falls back to local data/db.json store if unavailable)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/vibestream?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=7d

# Jamendo application client ID (register at developer.jamendo.com)
JAMENDO_CLIENT_ID=

# Optional Musopen API token for classical music catalog access
MUSOPEN_API_KEY=
